---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
---

<Layout title="EOL 数据采集 - 炎想科技" description="炎想科技EOL端到端数据采集方案演示。">
	<section class="py-8 lg:py-12">
		<div class="max-w-7xl mx-auto px-4 lg:px-8">
			<Breadcrumb href="/tech" label="技术能力" />
			<h1 class="mt-4 text-2xl lg:text-3xl font-bold text-slate-900">EOL 数据采集</h1>
			<p class="mt-2 text-slate-500">端到端数据采集方案演示</p>
		</div>
	</section>

	<section class="pb-16 lg:pb-24">
		<div class="max-w-7xl mx-auto px-4 lg:px-8">
			<div class="border border-dashed border-slate-300 rounded-xl p-12 text-center text-slate-400">
				EOL demo 待实现
			</div>
		</div>
	</section>
</Layout>
