---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
---

<Layout title="在线标注 - 炎想科技" description="体验炎想科技AI开发平台的在线数据标注功能。">
	<section class="py-8 lg:py-12">
		<div class="max-w-7xl mx-auto px-4 lg:px-8">
			<Breadcrumb href="/tech" label="技术能力" />
			<h1 class="mt-4 text-2xl lg:text-3xl font-bold text-slate-900">在线标注工具</h1>
			<p class="mt-2 text-slate-500">体验 AI 开发平台的数据标注功能</p>
		</div>
	</section>

	<!-- TODO: 引入 AnnotationDemo Preact 组件 -->
	<section class="pb-16 lg:pb-24">
		<div class="max-w-7xl mx-auto px-4 lg:px-8">
			<div class="border border-dashed border-slate-300 rounded-xl p-12 text-center text-slate-400">
				标注 demo 待实现
			</div>
		</div>
	</section>
</Layout>
