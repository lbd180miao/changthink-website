---
import Layout from '../layouts/Layout.astro';
import ViewfinderCard from '../components/ViewfinderCard.astro';

const icons: Record<string, string> = {
	eye: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>`,
	activity: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
	'bar-chart': `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
	grid: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>`,
};

const businessAreas = [
	{ title: '机器视觉', desc: '目标检测、缺陷检测、智能识别与 PLC/MES 联动', icon: 'eye', href: '/solutions#vision' },
	{ title: '数据采集', desc: '2D/3D相机、深度相机、雷达、光色仪插件化采集', icon: 'activity', href: '/solutions#acquisition' },
	{ title: '数据分析', desc: '机器学习、深度学习与工艺曲线质量挖掘', icon: 'bar-chart', href: '/solutions#analysis' },
	{ title: '管理系统', desc: 'MES、FMS 设备管理、Ignition 产线监控与自动排产', icon: 'grid', href: '/solutions#management' },
];

const featuredCases = [
	{
		tag: '智能排产软件',
		title: '涂装生产计划自动生成系统',
		desc: '综合换色成本、产线节拍与订单交期，一键自动生成可执行涂装排产计划，显著降低清洗损耗。',
		href: '/products#painting-plan',
		cta: '了解产品与体验入口',
	},
	{
		tag: '机器视觉 · 深度学习',
		title: '延锋能力中心与装货视觉检测',
		desc: '融合深度学习、OpenCV 与海康威视 VM，联动 PLC/MES 完成行为识别与产线装货实时防错。',
		href: '/solutions#vision',
		cta: '查看视觉方案',
	},
	{
		tag: '数据采集 · EOL',
		title: 'EOL 多源工业传感器采集项目',
		desc: '插件化接入工业 2D/3D 相机、深度相机与光色仪，为下线质量检测提供高可靠实时数据底座。',
		href: '/solutions#acquisition',
		cta: '查看采集方案',
	},
	{
		tag: '数据分析 · 产线系统',
		title: '超声波焊接包络线分析 & Ignition 产线集成',
		desc: '以机器学习判别焊接曲线质量，并结合 Ignition 与 Web 平台打造透明化制造运营系统。',
		href: '/solutions#analysis',
		cta: '查看分析与管理方案',
	},
];
---

<Layout title="炎想科技 - 工业智能解决方案" description="炎想科技专注工业智能，以计算机视觉与数据采集为核心，覆盖从感知到决策的完整链路。">
	<!-- Hero 区域 -->
	<section class="hero relative overflow-hidden bg-gradient-to-br from-blue-950 via-indigo-900 to-slate-900 text-white">
		<div class="max-w-7xl mx-auto px-4 lg:px-8 py-20 lg:py-32 relative z-10">
			<div class="max-w-2xl">
				<h1 class="text-4xl lg:text-5xl font-bold tracking-tight leading-tight">
					以<span class="text-blue-400">视觉智能</span>驱动<br />工业数字化转型
				</h1>
				<p class="mt-4 text-lg text-blue-200/80 leading-relaxed">
					<!-- TODO: 品牌标语待定 -->
					从感知到决策，覆盖工业智能全链路
				</p>
				<div class="mt-8 flex flex-wrap gap-4">
					<a
						href="/products"
						class="inline-flex items-center bg-blue-600 hover:bg-blue-700 text-white font-medium px-6 py-3 rounded-lg transition-colors duration-200"
					>
						浏览产品中心
					</a>
					<a
						href="/solutions"
						class="inline-flex items-center border border-blue-400/40 hover:border-blue-400/80 text-white font-medium px-6 py-3 rounded-lg transition-colors duration-200"
					>
						了解解决方案
					</a>
					<a
						href="/contact"
						class="inline-flex items-center border border-white/20 hover:border-white/50 text-blue-200 hover:text-white font-medium px-6 py-3 rounded-lg transition-colors duration-200"
					>
						联系我们
					</a>
				</div>
			</div>
		</div>

		<!-- 装饰：取景框圆环 -->
		<div class="hero-viewfinder" aria-hidden="true">
			<div class="viewfinder-ring"></div>
		</div>
	</section>

	<!-- 业务板块概览 -->
	<section class="py-16 lg:py-24">
		<div class="max-w-7xl mx-auto px-4 lg:px-8">
			<div class="text-center">
				<h2 class="text-2xl lg:text-3xl font-bold text-slate-900">业务领域</h2>
				<p class="mt-2 text-slate-500">覆盖工业智能全链路</p>
			</div>

			<div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
				{businessAreas.map((area) => (
					<a href={area.href} class="block group">
						<ViewfinderCard class="h-full border border-slate-200 rounded-xl p-6 bg-white hover:shadow-lg hover:border-blue-200 transition-all duration-300">
							<div class="flex items-center justify-center w-10 h-10 rounded-lg bg-blue-50 text-blue-500 mb-4" set:html={icons[area.icon]} />
							<h3 class="font-semibold text-slate-900 group-hover:text-blue-600 transition-colors">{area.title}</h3>
							<p class="mt-2 text-sm text-slate-500 leading-relaxed">{area.desc}</p>
						</ViewfinderCard>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- 代表性案例与产品亮点 -->
	<section class="py-16 lg:py-24 bg-slate-50">
		<div class="max-w-7xl mx-auto px-4 lg:px-8">
			<div class="text-center max-w-2xl mx-auto">
				<h2 class="text-2xl lg:text-3xl font-bold text-slate-900">典型案例与产品实践</h2>
				<p class="mt-2 text-slate-500">源自真实制造场景的软件产品与产线落地项目</p>
			</div>

			<div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6">
				{featuredCases.map((item) => (
					<ViewfinderCard class="border border-slate-200 rounded-xl p-7 bg-white hover:shadow-lg hover:border-blue-200 transition-all duration-300 flex flex-col">
						<span class="inline-block w-fit px-2.5 py-1 text-xs font-medium rounded-md bg-blue-50 text-blue-600">
							{item.tag}
						</span>
						<h3 class="mt-4 text-xl font-semibold text-slate-900">{item.title}</h3>
						<p class="mt-2.5 text-sm text-slate-600 leading-relaxed flex-1">{item.desc}</p>
						<a
							href={item.href}
							class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 hover:text-blue-700 transition-colors duration-200"
						>
							{item.cta}
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M5 12h14" />
								<path d="m12 5 7 7-7 7" />
							</svg>
						</a>
					</ViewfinderCard>
				))}
			</div>
		</div>
	</section>

	<!-- 底部 B2B 转化横幅 -->
	<section class="py-16 bg-slate-900 text-white">
		<div class="max-w-7xl mx-auto px-4 lg:px-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
			<div>
				<h2 class="text-2xl lg:text-3xl font-bold">开启您的工业智能升级</h2>
				<p class="mt-2 text-sm text-slate-300 max-w-xl">
					预约软件体验、获取免费场景可行性评估，或直接与我们的技术团队探讨您的产线需求。
				</p>
			</div>
			<div class="flex flex-wrap gap-3 shrink-0">
				<a
					href="/products"
					class="inline-flex items-center bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium px-6 py-3 rounded-lg transition-colors duration-200"
				>
					探索产品中心
				</a>
				<a
					href="/contact"
					class="inline-flex items-center border border-slate-600 hover:border-white text-white text-sm font-medium px-6 py-3 rounded-lg transition-colors duration-200"
				>
					联系我们
				</a>
			</div>
		</div>
	</section>
</Layout>

<style scoped>
	/* Hero 网格底纹 */
	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
		background-size: 48px 48px;
		pointer-events: none;
	}

	/* 取景框圆环装饰 */
	.hero-viewfinder {
		position: absolute;
		right: 8%;
		top: 50%;
		transform: translateY(-50%);
		width: 320px;
		height: 320px;
		border: 1px solid rgba(59, 130, 246, 0.15);
		border-radius: 50%;
	}

	.viewfinder-ring {
		position: absolute;
		inset: 48px;
		border: 1px solid rgba(59, 130, 246, 0.1);
		border-radius: 50%;
	}

	/* 十字准星 */
	.hero-viewfinder::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(rgba(59, 130, 246, 0.12), rgba(59, 130, 246, 0.12)) no-repeat center / 1px 100%,
			linear-gradient(90deg, rgba(59, 130, 246, 0.12), rgba(59, 130, 246, 0.12)) no-repeat center / 100% 1px;
	}

	@media (max-width: 1023px) {
		.hero-viewfinder {
			display: none;
		}
	}
</style>
