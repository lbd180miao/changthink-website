---
import Layout from '../layouts/Layout.astro';
---

<Layout title="关于我们 - 炎想科技" description="关于炎想科技，专注工业智能解决方案，联系方式与商务合作。">
	<!-- 公司简介 -->
	<section class="py-16 lg:py-24">
		<div class="max-w-7xl mx-auto px-4 lg:px-8">
			<h1 class="text-3xl lg:text-4xl font-bold text-slate-900">关于我们</h1>
			<p class="mt-3 text-lg text-slate-500 max-w-3xl">
				<!-- TODO: 公司介绍 -->
				炎想科技，专注工业智能解决方案。
			</p>
		</div>
	</section>

	<!-- 团队 / 优势 -->
	<section class="py-16 lg:py-24 bg-slate-50">
		<div class="max-w-7xl mx-auto px-4 lg:px-8">
			<h2 class="text-2xl font-bold text-slate-900">核心优势</h2>
			<!-- TODO: 团队背景、技术优势、合作伙伴 -->
		</div>
	</section>

	<!-- 联系我们 -->
	<section id="contact" class="py-16 lg:py-24">
		<div class="max-w-7xl mx-auto px-4 lg:px-8">
			<h2 class="text-2xl font-bold text-slate-900">联系我们</h2>
			<div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-8">
				<div>
					<h3 class="font-semibold text-slate-900">联系方式</h3>
					<ul class="mt-4 space-y-3">
						<li class="flex items-center gap-2.5 text-slate-600">
							<!-- TODO: 邮箱 -->
							contact@changthink.com
						</li>
						<li class="flex items-center gap-2.5 text-slate-600">
							<!-- TODO: 地址 -->
							地址待补充
						</li>
					</ul>
				</div>
				<div>
					<h3 class="font-semibold text-slate-900">商务合作</h3>
					<!-- TODO: 合作表单或二维码 -->
				</div>
			</div>
		</div>
	</section>
</Layout>
