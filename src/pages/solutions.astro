---
import Layout from '../layouts/Layout.astro';
import ViewfinderCard from '../components/ViewfinderCard.astro';
import { solutionAreas } from '../config/solutions';
---

<Layout title="解决方案 - 炎想科技" description="炎想科技针对工业场景的智能化落地方案：机器视觉、数据采集、数据分析、管理系统。">
	<!-- 页面标题 -->
	<section class="relative overflow-hidden bg-gradient-to-br from-blue-950 via-indigo-950 to-slate-900 text-white py-16 lg:py-24">
		<div class="max-w-7xl mx-auto px-4 lg:px-8">
			<span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-blue-500/20 text-blue-200 border border-blue-400/30">
				Industrial Solutions
			</span>
			<h1 class="mt-4 text-3xl lg:text-5xl font-bold tracking-tight">解决方案</h1>
			<p class="mt-4 text-lg text-blue-100/80 max-w-2xl leading-relaxed">
				紧贴制造业真实产线需求，覆盖感知、采集、分析与排产管理的端到端工业智能化落地方案。
			</p>

			<!-- 快速锚点导航 -->
			<div class="mt-8 flex flex-wrap gap-3">
				{solutionAreas.map((sol) => (
					<a
						href={`#${sol.id}`}
						class="px-4 py-2 rounded-lg text-sm font-medium bg-white/10 hover:bg-white/20 text-white border border-white/15 transition-colors duration-200"
					>
						{sol.label}
					</a>
				))}
			</div>
		</div>
	</section>

	{solutionAreas.map((sol, i) => (
		<section
			id={sol.id}
			class:list={[
				'scroll-mt-24 py-16 lg:py-24',
				i % 2 === 1 ? 'bg-slate-50' : 'bg-white',
			]}
		>
			<div class="max-w-7xl mx-auto px-4 lg:px-8">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
					<!-- 左侧：方案概述与技术路线 -->
					<div class="lg:col-span-5">
						<span class="text-xs font-semibold uppercase tracking-wider text-blue-600">
							0{i + 1} · {sol.enLabel}
						</span>
						<h2 class="mt-2 text-2xl lg:text-3xl font-bold text-slate-900">{sol.label}</h2>
						<p class="mt-2 text-base font-medium text-blue-700">{sol.tagline}</p>
						<p class="mt-4 text-sm text-slate-600 leading-relaxed">{sol.description}</p>

						<div class="mt-6">
							<h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400">核心覆盖</h3>
							<ul class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2.5">
								{sol.capabilities.map((cap) => (
									<li class="flex items-center gap-2 text-sm text-slate-700">
										<span class="w-1.5 h-1.5 rounded-full bg-blue-500 shrink-0"></span>
										{cap}
									</li>
								))}
							</ul>
						</div>

						<div class="mt-6">
							<h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400">技术路线</h3>
							<div class="mt-2.5 flex flex-wrap gap-2">
								{sol.techStack.map((tech) => (
									<span class="px-2.5 py-1 text-xs font-medium rounded-md bg-blue-50 text-blue-700 border border-blue-100">
										{tech}
									</span>
								))}
							</div>
						</div>

						<div class="mt-8 flex flex-wrap items-center gap-4">
							<a
								href="/contact"
								class="inline-flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors duration-200"
							>
								咨询此方案
							</a>
							{sol.relatedProduct && (
								<a
									href={sol.relatedProduct.href}
									class="inline-flex items-center gap-1 text-sm font-medium text-blue-600 hover:text-blue-700 transition-colors duration-200"
								>
									{sol.relatedProduct.label}
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M5 12h14" />
										<path d="m12 5 7 7-7 7" />
									</svg>
								</a>
							)}
						</div>
					</div>

					<!-- 右侧：典型落地方案与项目实例 -->
					<div class="lg:col-span-7 space-y-4">
						<div class="text-xs font-semibold uppercase tracking-wider text-slate-400">
							典型项目与落地实例
						</div>
						{sol.cases.map((item) => (
							<ViewfinderCard class="border border-slate-200 rounded-xl p-6 bg-white hover:shadow-md hover:border-blue-200 transition-all duration-300">
								<div class="flex flex-wrap items-center justify-between gap-2">
									<span class="text-xs font-medium text-blue-600 bg-blue-50 px-2.5 py-0.5 rounded">
										{item.category}
									</span>
									<span class="text-xs text-slate-400">{item.techRoute}</span>
								</div>
								<h3 class="mt-3 text-lg font-semibold text-slate-900">{item.name}</h3>
								<p class="mt-2 text-sm text-slate-600 leading-relaxed">{item.summary}</p>
							</ViewfinderCard>
						))}
					</div>
				</div>
			</div>
		</section>
	))}

	<!-- 底部咨询引导 -->
	<section class="py-16 bg-slate-900 text-white">
		<div class="max-w-7xl mx-auto px-4 lg:px-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
			<div>
				<h2 class="text-2xl font-bold">有具体的产线改造或检测需求？</h2>
				<p class="mt-2 text-sm text-slate-300">
					告诉我们您的工艺场景与节拍要求，炎想科技工程师为您提供前期可行性评估与方案建议。
				</p>
			</div>
			<a
				href="/contact"
				class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium px-6 py-3 rounded-lg shrink-0 transition-colors duration-200"
			>
				预约方案评估
			</a>
		</div>
	</section>
</Layout>
