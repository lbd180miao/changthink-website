---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面未找到 - 炎想科技" description="您访问的页面不存在。">
	<section class="py-24 lg:py-32">
		<div class="max-w-7xl mx-auto px-4 lg:px-8 text-center">
			<p class="text-7xl font-bold text-blue-500/20">404</p>
			<h1 class="mt-4 text-2xl lg:text-3xl font-bold text-slate-900">页面未找到</h1>
			<p class="mt-3 text-slate-500">您访问的页面不存在或已被移除。</p>
			<a href="/" class="mt-8 inline-flex items-center bg-blue-600 hover:bg-blue-700 text-white font-medium px-6 py-3 rounded-lg transition-colors duration-200">
				返回首页
			</a>
		</div>
	</section>
</Layout>
