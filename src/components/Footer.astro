---
import { navItems } from '../config/nav';
import { solutionAreas } from '../config/solutions';
import logoImg from '../assets/logo.png';

const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 text-slate-300">
	<div class="max-w-7xl mx-auto px-4 lg:px-8 py-12 lg:py-16">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
			<!-- 品牌信息 -->
			<div class="lg:col-span-1">
				<a href="/" class="inline-block">
					<img src={logoImg.src} alt="炎想科技" class="h-12 w-auto brightness-0 invert" />
				</a>
				<p class="mt-3 text-sm text-slate-400 leading-relaxed">
					专注工业智能解决方案，以计算机视觉、数据采集与分析为核心，助力制造业数字化转型。
				</p>
			</div>

			<!-- 快速链接 -->
			<div>
				<h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">快速链接</h3>
				<ul class="space-y-2.5">
					{navItems.map((link) => (
						<li>
							<a
								href={link.href}
								class="text-sm text-slate-400 hover:text-blue-400 transition-colors duration-200"
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<!-- 解决方案 -->
			<div>
				<h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">解决方案</h3>
				<ul class="space-y-2.5">
					{solutionAreas.map((area) => (
						<li>
							<a
								href={`/solutions#${area.id}`}
								class="text-sm text-slate-400 hover:text-blue-400 transition-colors duration-200"
							>
								{area.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<!-- 联系方式 -->
			<div>
				<h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">联系方式</h3>
				<ul class="space-y-3">
					<li class="flex items-start gap-2.5">
						<svg
							class="w-4 h-4 mt-0.5 text-blue-400 shrink-0"
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<rect width="20" height="16" x="2" y="4" rx="2" />
							<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
						</svg>
						<span class="text-sm text-slate-400">contact@changthink.com</span>
					</li>
					<li class="flex items-start gap-2.5">
						<svg
							class="w-4 h-4 mt-0.5 text-blue-400 shrink-0"
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path
								d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
							/>
							<circle cx="12" cy="10" r="3" />
						</svg>
						<span class="text-sm text-slate-400">地址待补充</span>
					</li>
				</ul>
			</div>
		</div>
	</div>

	<!-- 底部版权栏 -->
	<div class="border-t border-slate-800">
		<div
			class="max-w-7xl mx-auto px-4 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-2"
		>
			<p class="text-xs text-slate-500">&copy; {currentYear} 炎想科技. All rights reserved.</p>
		</div>
	</div>
</footer>
